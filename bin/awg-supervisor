#!/system/bin/sh
# awg-supervisor start|stop|status <config>
#
# A thin wrapper around the native awg-quick (compiled from
# amneziawg-tools/src/wg-quick/android.c). That binary already brings up
# the amneziawg-go userspace backend itself (via popen("amneziawg-go
# <iface>")), configures routes/iptables, and applies DNS via
# android.net.IDnsResolver over Binder - so this supervisor does not start
# amneziawg-go manually and does not touch routing/DNS itself, to avoid
# duplicating or conflicting with what android.c already does.
#
# scripts/routing.sh and scripts/dns.sh are OPTIONAL extra hooks (e.g. your
# own LAN bypass rules), only invoked after the main up when explicitly
# enabled via AWG_EXTRA_HOOKS=1.

MODDIR="${AWG_MODDIR:-$(cd "$(dirname "$0")/.." && pwd)}"
BIN="$MODDIR/bin"
IFACE="${AWG_IFACE:-wg0}"
LOG="$MODDIR/logs/supervisor.log"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG"; }

export PATH="$BIN:/system/bin:/system/xbin:$PATH"

# awg-quick (our compiled android.c) sends an `am broadcast` to the
# org.amnezia.awg app at the end of up/down to refresh its UI. We don't
# have that app installed - without this variable the broadcast targets a
# non-existent package, fails, and the whole `awg-quick up` gets rolled
# back (see broadcast_change() in wg-quick/android.c: if CALLING_PACKAGE
# matches AWG_PACKAGE_NAME, the broadcast is skipped entirely).
export CALLING_PACKAGE="org.amnezia.awg"

. "$MODDIR/scripts/network.sh"

do_start() {
  CONFIG="${1:-$MODDIR/config/wg0.conf}"
  if [ ! -f "$CONFIG" ]; then
    log "ERROR: config $CONFIG not found"
    exit 1
  fi

  wait_for_network 30 || log "WARNING: network did not come up in time, trying anyway"

  log "awg-quick up $CONFIG"
  "$BIN/awg-quick" up "$CONFIG" >> "$LOG" 2>&1
  RC=$?
  if [ $RC -ne 0 ]; then
    log "ERROR: awg-quick up exited with code $RC"
    exit $RC
  fi

  if [ "${AWG_EXTRA_HOOKS:-0}" = "1" ]; then
    "$MODDIR/scripts/routing.sh" up >> "$LOG" 2>&1
    "$MODDIR/scripts/dns.sh" up "$CONFIG" >> "$LOG" 2>&1
  fi

  log "AmneziaWG started successfully on $IFACE"
}

do_stop() {
  CONFIG="${1:-$MODDIR/config/wg0.conf}"

  if [ "${AWG_EXTRA_HOOKS:-0}" = "1" ]; then
    "$MODDIR/scripts/dns.sh" down >> "$LOG" 2>&1
    "$MODDIR/scripts/routing.sh" down >> "$LOG" 2>&1
  fi

  log "awg-quick down $CONFIG"
  "$BIN/awg-quick" down "$CONFIG" >> "$LOG" 2>&1

  log "AmneziaWG stopped"
}

do_status() {
  if ip link show "$IFACE" >/dev/null 2>&1; then
    echo "running"
    exit 0
  else
    echo "stopped"
    exit 1
  fi
}

case "$1" in
  start) do_start "$2" ;;
  stop) do_stop "$2" ;;
  status) do_status ;;
  *) echo "usage: awg-supervisor {start|stop|status} [config]"; exit 1 ;;
esac
